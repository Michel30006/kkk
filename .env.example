# Copia a .env y ajusta. NO subas .env al repositorio.
# Todas las variables son las que lee shared/src/config.cpp.

# --- Comunes ---------------------------------------------------------------
# SERVICE_NAME sólo aparece en logs y /ready; cada binario lo fija a su nombre.
# En la imagen Docker, SERVICE=server_a|server_b elige el ejecutable.
SERVICE_NAME=server_a
PORT=8080
LISTEN_ADDRESS=0.0.0.0
# PostgreSQL compartido por A y B. Sólo se admite este motor.
DATABASE_URL=postgresql://tds:tds@127.0.0.1:5432/ing_inversa
# Secreto compartido para llamadas internas. Mínimo 16 caracteres.
INTERNAL_TOKEN=cambio-obligatorio-1234567890
MIGRATIONS_DIR=./database/migrations
LOG_LEVEL=info

# URLs públicas para el ping mutuo (opcionales).
SERVER_A_URL=
SERVER_B_URL=
PING_INTERVAL_SECONDS=600
HTTP_TIMEOUT_SECONDS=10

# --- Descarga y codificación (Servidor A) ----------------------------------
MAX_VIDEO_BYTES=26214400
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=15
DOWNLOAD_MAX_SECONDS=300
MAX_REDIRECTS=3
ENCODE_PART_BYTES=65536
# Endurecimiento SSRF: por defecto sólo https público.
ALLOW_HTTP=0
ALLOW_PRIVATE_NETWORKS=0
# Lista separada por comas; vacío = cualquier host público.
ALLOWED_HOST_SUFFIXES=

# --- Entrega (Servidor B) --------------------------------------------------
# mock = escribe en MOCK_OUTBOX; todus = XMPP real.
TRANSPORT=mock
MOCK_OUTBOX=/tmp/tds-outbox
# Límite verificado de ToDus: 8192 bytes UTF-8 por stanza.
MAX_STANZA_BYTES=8192
SEND_DELAY_MS=120
MAX_SEND_RETRIES=3
ACK_TIMEOUT_MS=15000

# Credenciales de ToDus (sólo con TRANSPORT=todus). No inventar endpoints.
TODUS_USERNAME=
TODUS_PASSWORD=
# Alternativa a usuario/clave: JWT ya obtenido.
TODUS_TOKEN=
TODUS_AUTH_URL=https://auth.todus.cu/v2/auth/token
TODUS_DOMAIN=im.todus.cu
TODUS_PORT=5222
TODUS_RESOURCE=tds
TODUS_VERIFY_TLS=1

# --- Ciclo de vida ---------------------------------------------------------
WORKER_POLL_MS=1000
JOB_LEASE_SECONDS=180
STALE_JOB_MINUTES=60
RETENTION_HOURS=24
CLIENT_CONFIRM_HOURS=24
# Cada cuánto se expiran trabajos atascados y se purgan metadatos antiguos.
MAINTENANCE_INTERVAL_SECONDS=300
MAX_CONCURRENT_JOBS=1
